<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 独立 App 要读 QQ 的实际版本号(Android 11+ 需要声明可见性) -->
    <queries>
        <package android:name="com.tencent.mobileqq" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true">

        <activity
            android:name=".StatusActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 状态回传主通道:模块在 QQ 进程里 call() 进来写心跳 -->
        <provider
            android:name=".StatusProvider"
            android:authorities="com.livexp.qq.status"
            android:exported="true" />

        <!-- 广播兜底(部分 ROM 会 defer 跨进程广播) -->
        <receiver
            android:name=".StatusReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.livexp.qq.STATUS" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_desc" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />
    </application>

</manifest>
